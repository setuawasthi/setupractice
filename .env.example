# ============================================
# BetterTasks — Environment Variables
# ============================================

# Convex (auto-populated by `npx convex dev`)
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=http://127.0.0.1:3210
VITE_CONVEX_SITE_URL=http://127.0.0.1:3211

# Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=jMOtFn2rzeyaDxGa1pkhuQUaH5aHeU+qlwyGBsWfYmM=

# ============================================
# OAuth Providers (optional)
# ============================================
# 1. Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
#    Authorized redirect URI: https://your-vercel-app.vercel.app/api/auth/callback/google
# 2. Add these env vars on Vercel after getting credentials

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub Settings → Developer settings → OAuth Apps → New OAuth App
# Authorization callback URL: https://your-vercel-app.vercel.app/api/auth/callback/github

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
